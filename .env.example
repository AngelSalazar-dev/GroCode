# GroCode — environment configuration
#
# Copy to .env.local and fill in real values. .env* is gitignored.

# --- Database -------------------------------------------------------------
# PostgreSQL. El proveedor del esquema es "postgresql" (prisma/schema.prisma);
# una URL "mysql://" aqui hace fallar TODA consulta con
# "the URL must start with the protocol postgresql://".
#
# OJO con la precedencia de Next: `.env.local` gana sobre `.env`. Si tienes
# los dos archivos, hay que cambiar el DATABASE_URL en LOS DOS, o el que manda
# seguira siendo el viejo. Esa fue la trampa tras migrar a Postgres: la app
# seguia connectando a MySQL porque el `.env.local` conservaba la URL antigua.
#
# En Supabase la clave lleva caracteres especiales ($ y /) que hay que codificar
# en la URL (%24 y %2F), y hace falta sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# --- NextAuth v5 ----------------------------------------------------------
# IMPORTANT: v5 renamed NEXTAUTH_* to AUTH_*.
#   NEXTAUTH_SECRET is silently ignored, which makes every auth() call throw
#   MissingSecret and breaks the entire signed-in surface.
# Generate with: npx auth secret
AUTH_SECRET="generate-me-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- OAuth providers ------------------------------------------------------
GITHUB_ID="your-github-oauth-client-id"
GITHUB_SECRET="your-github-oauth-client-secret"

# --- Seed (development only) ----------------------------------------------
# `npm run db:seed` refuses to run with NODE_ENV=production, a DATABASE_URL
# containing "prod", or a non-local host (localhost needs no opt-in).
# Without SEED_PASSWORD every seeded user gets a random password (you cannot
# log in as them); set it to share one password locally.
# SEED_PASSWORD="only-for-local-development"
# SEED_ALLOW_REMOTE="1"   # only for a disposable remote dev database

# --- Tests only -----------------------------------------------------------
# A DISPOSABLE database. The smoke test refuses to run against the production
# DATABASE_URL; point this at a throwaway schema instead.
# In Postgres, isolation is by SCHEMA, not by database name.
# SMOKE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=grocode_smoke&sslmode=require"
#
# NOTE: the guard in scripts/smoke-auth.mjs checks the DATABASE name, so on
# Postgres it will refuse a URL whose database is "postgres" even if it points
# at a throwaway schema. That guard is deliberate; see the note there.