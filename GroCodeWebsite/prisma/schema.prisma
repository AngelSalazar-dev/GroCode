generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated-v4/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  JUNIOR
  SENIOR
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(JUNIOR)
  bio           String?   @db.Text
  location      String?
  website       String?
  
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  
  // Follows
  followers     Follow[]  @relation("following")
  following     Follow[]  @relation("follower")
  
  likes       Like[]
  bookmarks   Bookmark[]
  comments    Comment[]

  // Mentorships
  sentRequests     MentorshipRequest[] @relation("junior")
  receivedRequests MentorshipRequest[] @relation("senior")

  // Collaboration & Skills
  skills           Skill[]
  projects         Project[]  @relation("ProjectOwner")
  collaborations   Project[]  @relation("ProjectCollaborators")
  sentCollabReqs   CollaborationRequest[] @relation("CollabSender")
  receivedCollabReqs CollaborationRequest[] @relation("CollabReceiver")
  
  // Messaging
  chatChannels     ChatChannel[]
  messages         ChatMessage[]

  // Notifications
  notifications    Notification[]

  // Reviews
  reviewsGiven     Review[] @relation("Reviewer")
  reviewsReceived  Review[] @relation("Mentor")

  // Senior Applications
  seniorApplication SeniorApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id          String   @id @default(cuid())
  content     String   @db.Text
  resourceUrl String?
  channel     String   @default("general")
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       Like[]
  bookmarks   Bookmark[]
  comments    Comment[]
  createdAt   DateTime @default(now())
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model MentorshipRequest {
  id        String        @id @default(cuid())
  message   String?       @db.Text
  status    RequestStatus @default(PENDING)
  juniorId  String
  seniorId  String
  junior    User          @relation("junior", fields: [juniorId], references: [id], onDelete: Cascade)
  senior    User          @relation("senior", fields: [seniorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([juniorId, seniorId])
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  projects  Project[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  skills      Skill[]
  collaborators User[] @relation("ProjectCollaborators")
  requests    CollaborationRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CollaborationRequest {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation("CollabSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User          @relation("CollabReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(PENDING)
  message     String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([projectId, senderId])
}

model ChatChannel {
  id        String        @id @default(cuid())
  users     User[]
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id        String      @id @default(cuid())
  content   String      @db.Text
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // LIKE, COMMENT, FOLLOW, MENTORSHIP, COLLABORATION
  message   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?  @db.Text
  reviewerId String
  reviewer  User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    User     @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewerId, mentorId])
}

model SeniorApplication {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience  Int      // Years of experience
  githubUrl   String?
  linkedinUrl String?
  techStack   String   @db.Text
  motivation  String   @db.Text
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
