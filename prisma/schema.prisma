generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated-v2/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  JUNIOR
  SENIOR
  /// Staff. Can review and approve SeniorApplications. Granted manually.
  ADMIN
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
}
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(JUNIOR)
  bio           String?   @db.Text
  location      String?
  website      String?

  // Set once the user has completed the onboarding role choice.
  onboardingCompleted Boolean @default(false)

  
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  
  // Follows
  followers     Follow[]  @relation("following")
  following     Follow[]  @relation("follower")
  
  likes       Like[]
  bookmarks   Bookmark[]
  comments    Comment[]

  // Mentorships
  sentRequests     MentorshipRequest[] @relation("junior")
  receivedRequests MentorshipRequest[] @relation("senior")

  // Senior Applications
  seniorApplications SeniorApplication[]

  // Notifications
  notifications      Notification[]
  sentNotifications  Notification[] @relation("NotificationFromUser")

  // Roadmap
  roadmapProgress    RoadmapProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id          String   @id @default(cuid())
  content     String   @db.Text
  resourceUrl String?
  channel     String   @default("general")
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       Like[]
  bookmarks   Bookmark[]
  comments    Comment[]
  notifications Notification[]
  createdAt   DateTime @default(now())

  // The feed runs `WHERE channel = ? ORDER BY createdAt DESC LIMIT n`. Without
  // this index that is a full table scan plus a filesort on every request.
  @@index([channel, createdAt(sort: Desc)])
  // Serves the "posts by author" list on a profile, newest first.
  @@index([authorId, createdAt(sort: Desc)])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  // The existing unique index leads with userId, so it cannot serve
  // "how many likes does this post have".
  @@index([postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Comments are read newest-first per post.
  @@index([postId, createdAt(sort: Desc)])
}

model Follow {
  followerId  String
  followingId String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  // Serves the "who follows X" lookup on a profile.
  @@index([followingId])
}

model MentorshipRequest {
  id        String        @id @default(cuid())
  message   String?       @db.Text
  status    RequestStatus @default(PENDING)
  juniorId  String
  seniorId  String
  junior    User          @relation("junior", fields: [juniorId], references: [id], onDelete: Cascade)
  senior    User          @relation("senior", fields: [seniorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  respondedAt DateTime?

  @@unique([juniorId, seniorId])
  @@index([seniorId, status])
}

model SeniorApplication {
  id                String   @id @default(cuid())
  userId            String
  yearsOfExperience String?
  technologies      String?
  githubProfile     String?
  linkedinProfile   String?
  motivation        String?
  status            ApplicationStatus @default(PENDING)
  reviewedAt        DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One application per user, enforced by the database. Re-applying after a
  // rejection updates this same row (see applySenior), so uniqueness does not
  // prevent re-applying — it only prevents two concurrent submissions from
  // creating two PENDING rows, one of which would sit orphaned in /admin.
  @@unique([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  content   String   @db.Text
  link      String?
  read      Boolean  @default(false)
  userId    String
  fromUserId String?
  postId    String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromUser  User?    @relation("NotificationFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt(sort: Desc)])
  // getNotifications orders by createdAt DESC for a single user; without this
  // the existing composite index forces a filesort.
  @@index([userId, createdAt(sort: Desc)])
}

model RoadmapStep {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  color       String   @default("text-accent-gro")
  order       Int
  resources   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Per-user completion, so the roadmap reflects real progress.
  progress RoadmapProgress[]

  @@index([order])
}

model RoadmapProgress {
  userId    String
  stepId    String
  completed Boolean   @default(false)
  completedAt DateTime?
  updatedAt DateTime @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  step RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@id([userId, stepId])
}
